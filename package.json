{
  "name": "jarvis-v0-2",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run server:watch\"",
    "dev:tailscale": "cross-env JARVIS_REMOTE_ACCESS_MODE=tailscale concurrently \"vite\" \"npm run server:watch\"",
    "service:install": "bash scripts/install-service.sh",
    "service:start": "systemctl --user start jarvis-v02.service",
    "service:stop": "systemctl --user stop jarvis-v02.service",
    "service:restart": "systemctl --user restart jarvis-v02.service",
    "service:status": "systemctl --user status jarvis-v02.service --no-pager",
    "service:logs": "journalctl --user -u jarvis-v02.service -n 100 --no-pager",
    "codex:service:install": "bash scripts/install-codex-service.sh",
    "codex:service:start": "systemctl --user start codex-remote-control.service",
    "codex:service:stop": "systemctl --user stop codex-remote-control.service",
    "codex:service:restart": "systemctl --user restart codex-remote-control.service",
    "codex:service:status": "systemctl --user status codex-remote-control.service --no-pager",
    "codex:service:logs": "journalctl --user -u codex-remote-control.service -n 100 --no-pager",
    "server:watch": "bash scripts/watch-server.sh",
    "verify:runtime": "bash scripts/check-runtime.sh",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.77.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5"
  }
}
